<?xml version="1.0" ?>
<zabbix_export>
    <version>7.0</version>
    <template_groups>
        <template_group>
            <uuid>80ae635248ef47d59347a58358b40b4f</uuid>
            <name>Templates/Applications</name>
        </template_group>
    </template_groups>
    <templates>
        <template>
            <uuid>8ac7c7de26b34ed2bf56ec235b41e25a</uuid>
            <template>Template Hermes Agent</template>
            <name>Template Hermes Agent</name>
            <description>Zabbix template for monitoring Hermes Agent via its built-in API Server. Monitors gateway health, platform connectivity, token consumption, session activity, and tool usage.</description>
            <groups>
                <group>
                    <name>Templates/Applications</name>
                </group>
            </groups>
            <items/>
            <discovery_rules>
                <discovery_rule>
                    <uuid>7ea98662d44d478b88d5bdbe803ab9e6</uuid>
                    <name>Discover Hermes Profiles</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>hermes.profiles.discovery</key>
                    <delay>1h</delay>
                    <filter>
                        <evaltype>AND_OR</evaltype>
                        <conditions>
                            <condition>
                                <macro>{#PROFILE}</macro>
                                <value>.*</value>
                                <operator>MATCHES_REGEX</operator>
                                <formulaid>A</formulaid>
                            </condition>
                        </conditions>
                    </filter>
                    <lifetime_type>DELETE_AFTER</lifetime_type>
                    <lifetime>7d</lifetime>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>412e2b11d53241108a56c5648735f047</uuid>
                            <name>{#PROFILE}: Gateway running</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;health&quot;,&quot;gateway_up&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.gateway_up</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>267f44b6e89c4f9b8d17c0df3d14d240</uuid>
                            <name>{#PROFILE}: Active agents</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;health&quot;,&quot;active_agents&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.active_agents</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>c86266b89ab84a299be97f0ee2012925</uuid>
                            <name>{#PROFILE}: Platforms connected</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;health&quot;,&quot;platforms_connected&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.platforms_connected</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>c29949c1f0334a35baeddff0170d5840</uuid>
                            <name>{#PROFILE}: Platforms total</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;health&quot;,&quot;platforms_total&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.platforms_total</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>13a333d68e9749438b7c8c30fce1b05f</uuid>
                            <name>{#PROFILE}: Gateway PID</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;health&quot;,&quot;pid&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.pid</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>f2279b77a696491dabf4de29fbf2d10e</uuid>
                            <name>{#PROFILE}: Input tokens</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;input_tokens&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_input_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>512416f0b38046d69378897d204f0266</uuid>
                            <name>{#PROFILE}: Output tokens</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;output_tokens&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_output_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>81d46b4be3a34927ac0e395b7f6fffac</uuid>
                            <name>{#PROFILE}: Cache read tokens</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;cache_read_tokens&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_cache_read_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>f901877b69874c218a5f1287538bcacf</uuid>
                            <name>{#PROFILE}: Tokens (7d)</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;tokens_7d&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.tokens_7d</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>36232485555e4dec81a653c18c9dec1b</uuid>
                            <name>{#PROFILE}: Active sessions</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;active_sessions&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.active_sessions</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>8cdad58273d5423d99ac42e9bf0b0422</uuid>
                            <name>{#PROFILE}: Total sessions</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;total_sessions&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_sessions</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>9526f357e2364e3aaee6e9594a359ecc</uuid>
                            <name>{#PROFILE}: Tool calls</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;tool_calls&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_tool_calls</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>cd4ae81ad43749fea22c7001b631f4d9</uuid>
                            <name>{#PROFILE}: Messages</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;total_messages&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_messages</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                    </item_prototypes>
                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>2631a2b14ae0462bb22239204aa9739d</uuid>
                            <name>{#PROFILE}: Token consumption</name>
                            <width>900</width>
                            <height>200</height>
                            <ymin_type_1>CALCULATED</ymin_type_1>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <color>1A7BFF</color>
                                    <yaxisside>LEFT</yaxisside>
                                    <calc_fnc>LAST</calc_fnc>
                                    <type>SIMPLE</type>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check[&quot;tokens&quot;,&quot;input_tokens&quot;,&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <sortorder>1</sortorder>
                                    <color>00E676</color>
                                    <yaxisside>LEFT</yaxisside>
                                    <calc_fnc>LAST</calc_fnc>
                                    <type>SIMPLE</type>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check[&quot;tokens&quot;,&quot;output_tokens&quot;,&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <sortorder>2</sortorder>
                                    <color>FF9100</color>
                                    <yaxisside>LEFT</yaxisside>
                                    <calc_fnc>LAST</calc_fnc>
                                    <type>SIMPLE</type>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check[&quot;tokens&quot;,&quot;cache_read_tokens&quot;,&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                        <graph_prototype>
                            <uuid>c7dbd6a5cbe44b60beb1abe8352ae192</uuid>
                            <name>{#PROFILE}: Session activity</name>
                            <width>900</width>
                            <height>200</height>
                            <ymin_type_1>CALCULATED</ymin_type_1>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <color>1A7BFF</color>
                                    <yaxisside>LEFT</yaxisside>
                                    <calc_fnc>AVG</calc_fnc>
                                    <type>SIMPLE</type>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check[&quot;tokens&quot;,&quot;active_sessions&quot;,&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <sortorder>1</sortorder>
                                    <color>00E676</color>
                                    <yaxisside>LEFT</yaxisside>
                                    <calc_fnc>AVG</calc_fnc>
                                    <type>SIMPLE</type>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check[&quot;tokens&quot;,&quot;total_sessions&quot;,&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                    <trigger_prototypes>
                        <trigger_prototype>
                            <uuid>bd7a1e570de5437c96645f9a35166c1e</uuid>
                            <expression>{HOST.HOST:hermes.check[&quot;health&quot;,&quot;gateway_up&quot;,&quot;{#PROFILE}&quot;].last()}=0</expression>
                            <name>{#PROFILE}: Gateway process is down</name>
                            <priority>HIGH</priority>
                        </trigger_prototype>
                        <trigger_prototype>
                            <uuid>3e1bff7ac6314976a4f01652d9ae1218</uuid>
                            <expression>{HOST.HOST:hermes.check[&quot;tokens&quot;,&quot;active_sessions&quot;,&quot;{#PROFILE}&quot;].last()}=0 and {HOST.HOST:hermes.check[&quot;tokens&quot;,&quot;active_sessions&quot;,&quot;{#PROFILE}&quot;].avg(1h)}=0</expression>
                            <name>{#PROFILE}: No active sessions for 1h</name>
                            <priority>INFO</priority>
                        </trigger_prototype>
                        <trigger_prototype>
                            <uuid>e748ce60f31a4d7e965fe92b3fe3d1af</uuid>
                            <expression>{HOST.HOST:hermes.check[&quot;tokens&quot;,&quot;tool_calls&quot;,&quot;{#PROFILE}&quot;].change()}&gt;500</expression>
                            <name>{#PROFILE}: Tool call spike</name>
                            <priority>WARNING</priority>
                        </trigger_prototype>
                    </trigger_prototypes>
                </discovery_rule>
            </discovery_rules>
        </template>
    </templates>
</zabbix_export>

