<?xml version="1.0" ?>
<zabbix_export>
    <version>7.0</version>
    <template_groups>
        <template_group>
            <uuid>8a2e500b-6585-45e7-a6e4-874b19f8c8ce</uuid>
            <name>Templates/Applications</name>
        </template_group>
    </template_groups>
    <templates>
        <template>
            <uuid>0018338a-863d-45e1-9f51-c0e9d2ee1f39</uuid>
            <template>Template Hermes Agent</template>
            <name>Template Hermes Agent</name>
            <description>Zabbix template for monitoring Hermes Agent via its built-in API Server. Monitors gateway health, platform connectivity, token consumption, session activity, and tool usage across Hermes profiles with API_SERVER_ENABLED=true.</description>
            <groups>
                <group>
                    <name>Templates/Applications</name>
                </group>
            </groups>
            <items/>
            <discovery_rules>
                <discovery_rule>
                    <uuid>29aafe59-a07e-436c-a8a7-cb9f53321b33</uuid>
                    <name>Discover Hermes Profiles</name>
                    <key>hermes.profiles.discovery</key>
                    <delay>1h</delay>
                    <filter>
                        <conditions>
                            <condition>
                                <macro>{#PROFILE}</macro>
                                <value>.*</value>
                                <formulaid>A</formulaid>
                                <operator>REGEXP</operator>
                            </condition>
                        </conditions>
                    </filter>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>68f8f53d-5bdc-4ac5-8b33-52692fa2e14f</uuid>
                            <name>{#PROFILE}: Gateway running</name>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.gateway_up</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <triggers>
                                <trigger_prototype>
                                    <uuid>2b980ae2-2fe4-4b9b-ad7b-64d41b047cb8</uuid>
                                    <expression>{last()}=0</expression>
                                    <name>{#PROFILE}: Gateway process is down</name>
                                    <priority>HIGH</priority>
                                </trigger_prototype>
                            </triggers>
                        </item_prototype>
                        <item_prototype>
                            <uuid>af55bd6b-d422-4aa0-b49d-fc411a512608</uuid>
                            <name>{#PROFILE}: Active agents</name>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.active_agents</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>2e79cbc5-0ca0-483b-a29b-14e87281d292</uuid>
                            <name>{#PROFILE}: Platforms connected</name>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.platforms_connected</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>fb3744d8-21da-4e69-9831-421833e5ff0a</uuid>
                            <name>{#PROFILE}: Platforms total</name>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.platforms_total</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>c51a67a1-fa1b-4898-a314-edd529edba5b</uuid>
                            <name>{#PROFILE}: Gateway PID</name>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.pid</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>9adfb566-e737-44dc-bed5-8946ec4dcb6f</uuid>
                            <name>{#PROFILE}: Input tokens</name>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_input_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>853b67ae-b655-4f52-89eb-54b80f3aa54b</uuid>
                            <name>{#PROFILE}: Output tokens</name>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_output_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>a2d0be43-a63a-4670-bd96-22aba9f438f1</uuid>
                            <name>{#PROFILE}: Cache read tokens</name>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_cache_read_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>05632bfd-0d3d-4d53-b023-614314dafb2b</uuid>
                            <name>{#PROFILE}: Tokens (7d)</name>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.tokens_7d</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>6b1f8dbc-5d08-42e3-b612-5a4138f04052</uuid>
                            <name>{#PROFILE}: Active sessions</name>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.active_sessions</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <triggers>
                                <trigger_prototype>
                                    <uuid>7e3d2dd7-48ce-4d5f-8c9c-0edc61697077</uuid>
                                    <expression>{last()}=0 and {avg(1h)}=0</expression>
                                    <name>{#PROFILE}: No active sessions for 1h</name>
                                    <priority>INFO</priority>
                                </trigger_prototype>
                            </triggers>
                        </item_prototype>
                        <item_prototype>
                            <uuid>ea97925b-8112-4d8e-8e47-64edf8db499a</uuid>
                            <name>{#PROFILE}: Total sessions</name>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_sessions</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>98da72d4-13c0-4551-98f7-e96cfd91eed3</uuid>
                            <name>{#PROFILE}: Tool calls</name>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_tool_calls</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <triggers>
                                <trigger_prototype>
                                    <uuid>6c09b6bd-633e-4df4-ae49-4e3b910b4b44</uuid>
                                    <expression>{change()}&gt;500</expression>
                                    <name>{#PROFILE}: Tool call spike</name>
                                    <priority>WARNING</priority>
                                </trigger_prototype>
                            </triggers>
                        </item_prototype>
                        <item_prototype>
                            <uuid>49fb9eac-616e-4fc6-b70d-b0c3d315600d</uuid>
                            <name>{#PROFILE}: Messages</name>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_messages</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                    </item_prototypes>
                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>8b4c30ef-7358-453a-8aac-c5aa90b5a088</uuid>
                            <name>{#PROFILE}: Token consumption</name>
                            <width>900</width>
                            <height>200</height>
                            <ymin_type_1>0</ymin_type_1>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                    <color>1A7BFF</color>
                                    <yaxisside>0</yaxisside>
                                    <calc_fnc>7</calc_fnc>
                                    <type>0</type>
                                </graph_item>
                            </graph_items>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                    <color>00E676</color>
                                    <yaxisside>0</yaxisside>
                                    <calc_fnc>7</calc_fnc>
                                    <type>0</type>
                                </graph_item>
                            </graph_items>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                    <color>FF9100</color>
                                    <yaxisside>0</yaxisside>
                                    <calc_fnc>7</calc_fnc>
                                    <type>0</type>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                        <graph_prototype>
                            <uuid>d0a2315b-cf90-472e-9398-045cf379944a</uuid>
                            <name>{#PROFILE}: Session activity</name>
                            <width>900</width>
                            <height>200</height>
                            <ymin_type_1>0</ymin_type_1>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                    <color>1A7BFF</color>
                                    <yaxisside>0</yaxisside>
                                    <calc_fnc>2</calc_fnc>
                                    <type>0</type>
                                </graph_item>
                            </graph_items>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                    <color>00E676</color>
                                    <yaxisside>0</yaxisside>
                                    <calc_fnc>2</calc_fnc>
                                    <type>0</type>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                </discovery_rule>
            </discovery_rules>
        </template>
    </templates>
</zabbix_export>

