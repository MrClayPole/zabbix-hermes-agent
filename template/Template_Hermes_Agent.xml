<?xml version="1.0" ?>
<zabbix_export>
    <version>7.0</version>
    <template_groups>
        <template_group>
            <uuid>0f723728be77451590fd4dbf13f38b82</uuid>
            <name>Templates/Applications</name>
        </template_group>
    </template_groups>
    <templates>
        <template>
            <uuid>025144002abc4a5a98cf1071e945e337</uuid>
            <template>Template Hermes Agent</template>
            <name>Template Hermes Agent</name>
            <description>Zabbix template for monitoring Hermes Agent via its built-in API Server. Monitors gateway health, platform connectivity, token consumption, session activity, and tool usage.</description>
            <groups>
                <group>
                    <name>Templates/Applications</name>
                </group>
            </groups>
            <items/>
            <macros>
                <macro>
                    <macro>{$HERMES.API.HOST}</macro>
                    <value>127.0.0.1</value>
                    <description>Hermes API server hostname or IP</description>
                </macro>
                <macro>
                    <macro>{$HERMES.API.PORT}</macro>
                    <value>8642</value>
                    <description>Hermes API server port</description>
                </macro>
                <macro>
                    <macro>{$HERMES.API.KEY}</macro>
                    <value/>
                    <description>Hermes API server key (set per-host)</description>
                </macro>
            </macros>
            <discovery_rules>
                <discovery_rule>
                    <uuid>0ddb3e5ac16c43fba92c294a3dd4fad2</uuid>
                    <name>Discover Hermes Profiles</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>hermes.profiles.discovery</key>
                    <delay>1h</delay>
                    <filter>
                        <evaltype>AND_OR</evaltype>
                        <conditions>
                            <condition>
                                <macro>{#PROFILE}</macro>
                                <value>.*</value>
                                <operator>MATCHES_REGEX</operator>
                                <formulaid>A</formulaid>
                            </condition>
                        </conditions>
                    </filter>
                    <lifetime_type>DELETE_AFTER</lifetime_type>
                    <lifetime>7d</lifetime>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>bf25fdd100fa4498a4c75b7dc572abd4</uuid>
                            <name>{#PROFILE}: Gateway running</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;health&quot;,&quot;gateway_up&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.gateway_up</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>37b0dfc5cf4e44b0a1239c9c87de370f</uuid>
                            <name>{#PROFILE}: Active agents</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;health&quot;,&quot;active_agents&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.active_agents</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>091d85a84d22443b84ed337567704f25</uuid>
                            <name>{#PROFILE}: Platforms connected</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;health&quot;,&quot;platforms_connected&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.platforms_connected</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>8ba586e5972d487ca734e26290ca381d</uuid>
                            <name>{#PROFILE}: Platforms total</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;health&quot;,&quot;platforms_total&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.platforms_total</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>300282b8f0d948ce870fec55837268d8</uuid>
                            <name>{#PROFILE}: Gateway PID</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;health&quot;,&quot;pid&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.pid</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>f55e74f51a754c5880735629c3f98625</uuid>
                            <name>{#PROFILE}: Input tokens</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;input_tokens&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_input_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>847dc85df3ee45f382f118161e54bf5d</uuid>
                            <name>{#PROFILE}: Output tokens</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;output_tokens&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_output_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>a2bdf6da23904ef2b92b1a3042632bc6</uuid>
                            <name>{#PROFILE}: Cache read tokens</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;cache_read_tokens&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_cache_read_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>ae785622798b4bb5ace1178db7af02d9</uuid>
                            <name>{#PROFILE}: Tokens (7d)</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;tokens_7d&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.tokens_7d</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>efd193ed4dd442818219520bf11c4fc3</uuid>
                            <name>{#PROFILE}: Active sessions</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;active_sessions&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.active_sessions</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>4a4d161e55f84c87a3def1f87220f802</uuid>
                            <name>{#PROFILE}: Total sessions</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;total_sessions&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_sessions</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>b822bf9c10474e6c8b5dfdd1cf980977</uuid>
                            <name>{#PROFILE}: Tool calls</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;tool_calls&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_tool_calls</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>4f4a732cefe8485bb621f86250078406</uuid>
                            <name>{#PROFILE}: Messages</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;total_messages&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_messages</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                    </item_prototypes>
                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>5804c8c6c423454dbdccbd8a8d4042e3</uuid>
                            <name>{#PROFILE}: Token consumption</name>
                            <width>900</width>
                            <height>200</height>
                            <ymin_type_1>CALCULATED</ymin_type_1>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <color>1A7BFF</color>
                                    <yaxisside>LEFT</yaxisside>
                                    <calc_fnc>LAST</calc_fnc>
                                    <type>SIMPLE</type>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check[&quot;tokens&quot;,&quot;input_tokens&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <sortorder>1</sortorder>
                                    <color>00E676</color>
                                    <yaxisside>LEFT</yaxisside>
                                    <calc_fnc>LAST</calc_fnc>
                                    <type>SIMPLE</type>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check[&quot;tokens&quot;,&quot;output_tokens&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <sortorder>2</sortorder>
                                    <color>FF9100</color>
                                    <yaxisside>LEFT</yaxisside>
                                    <calc_fnc>LAST</calc_fnc>
                                    <type>SIMPLE</type>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check[&quot;tokens&quot;,&quot;cache_read_tokens&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                        <graph_prototype>
                            <uuid>5eca680cd87742c0a1111f5d0ef14a9d</uuid>
                            <name>{#PROFILE}: Session activity</name>
                            <width>900</width>
                            <height>200</height>
                            <ymin_type_1>CALCULATED</ymin_type_1>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <color>1A7BFF</color>
                                    <yaxisside>LEFT</yaxisside>
                                    <calc_fnc>AVG</calc_fnc>
                                    <type>SIMPLE</type>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check[&quot;tokens&quot;,&quot;active_sessions&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <sortorder>1</sortorder>
                                    <color>00E676</color>
                                    <yaxisside>LEFT</yaxisside>
                                    <calc_fnc>AVG</calc_fnc>
                                    <type>SIMPLE</type>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check[&quot;tokens&quot;,&quot;total_sessions&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                    <trigger_prototypes>
                        <trigger_prototype>
                            <uuid>3c8e99a78e624544b8292c8c5162b1f0</uuid>
                            <expression>last(/Template Hermes Agent/hermes.check[&quot;health&quot;,&quot;gateway_up&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;])=0</expression>
                            <name>{#PROFILE}: Gateway process is down</name>
                            <priority>HIGH</priority>
                        </trigger_prototype>
                        <trigger_prototype>
                            <uuid>931f0a5ff4fe4fe787f6503ac56583f9</uuid>
                            <expression>last(/Template Hermes Agent/hermes.check[&quot;tokens&quot;,&quot;active_sessions&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;])=0 and avg(/Template Hermes Agent/hermes.check[&quot;tokens&quot;,&quot;active_sessions&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;],1h)=0</expression>
                            <name>{#PROFILE}: No active sessions for 1h</name>
                            <priority>INFO</priority>
                        </trigger_prototype>
                        <trigger_prototype>
                            <uuid>0fe8e7c89699489394816ee2d8f95f95</uuid>
                            <expression>change(/Template Hermes Agent/hermes.check[&quot;tokens&quot;,&quot;tool_calls&quot;,&quot;{#PROFILE}&quot;,&quot;{$HERMES.API.HOST}&quot;,&quot;{$HERMES.API.PORT}&quot;,&quot;{$HERMES.API.KEY}&quot;])&gt;500</expression>
                            <name>{#PROFILE}: Tool call spike</name>
                            <priority>WARNING</priority>
                        </trigger_prototype>
                    </trigger_prototypes>
                </discovery_rule>
            </discovery_rules>
        </template>
    </templates>
</zabbix_export>

