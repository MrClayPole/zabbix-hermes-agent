<?xml version="1.0" ?>
<zabbix_export>
    <version>7.0</version>
    <template_groups>
        <template_group>
            <uuid>ffdbed54-405b-4280-9cce-475f18999e16</uuid>
            <name>Templates/Applications</name>
        </template_group>
    </template_groups>
    <templates>
        <template>
            <uuid>14c01de7-95b0-475a-8c8f-783e5fed84b5</uuid>
            <template>Template Hermes Agent</template>
            <name>Template Hermes Agent</name>
            <description>Zabbix template for monitoring Hermes Agent via its built-in API Server. Monitors gateway health, platform connectivity, token consumption, session activity, and tool usage.</description>
            <groups>
                <group>
                    <name>Templates/Applications</name>
                </group>
            </groups>
            <items/>
            <discovery_rules>
                <discovery_rule>
                    <uuid>86a20cc9-1454-4625-a313-172bb3f956c1</uuid>
                    <name>Discover Hermes Profiles</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>hermes.profiles.discovery</key>
                    <delay>1h</delay>
                    <filter>
                        <evaltype>AND_OR</evaltype>
                        <conditions>
                            <condition>
                                <macro>{#PROFILE}</macro>
                                <value>.*</value>
                                <operator>MATCHES_REGEX</operator>
                                <formulaid>A</formulaid>
                            </condition>
                        </conditions>
                    </filter>
                    <lifetime_type>DELETE_AFTER</lifetime_type>
                    <lifetime>7d</lifetime>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>e28d6cf2-0c69-4447-87fe-c096bc878d21</uuid>
                            <name>{#PROFILE}: Gateway running</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.gateway_up</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>10c355e2-cfe6-4fa4-b9fa-2afac941d68c</uuid>
                                    <expression>{last()}=0</expression>
                                    <name>{#PROFILE}: Gateway process is down</name>
                                    <priority>HIGH</priority>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <uuid>2d59bd1c-ff6c-4ef7-acb4-c47e54287848</uuid>
                            <name>{#PROFILE}: Active agents</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.active_agents</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>a8c05e19-f9b3-44ad-8355-dffadfda4880</uuid>
                            <name>{#PROFILE}: Platforms connected</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.platforms_connected</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>96a1f8ee-4257-4497-9433-05a376a72448</uuid>
                            <name>{#PROFILE}: Platforms total</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.platforms_total</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>075b421b-05b5-4e78-b7c1-e15a64226699</uuid>
                            <name>{#PROFILE}: Gateway PID</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.pid</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>ca6fc8a3-25e5-4372-bae2-6f49509e51e5</uuid>
                            <name>{#PROFILE}: Input tokens</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_input_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>b5801558-ac69-4ba5-82fc-8beeda044cb2</uuid>
                            <name>{#PROFILE}: Output tokens</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_output_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>d5a711ba-0887-4db9-821d-226a6b3e5dec</uuid>
                            <name>{#PROFILE}: Cache read tokens</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_cache_read_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>32dc1e60-9458-4798-a7b2-9da31fc49a5e</uuid>
                            <name>{#PROFILE}: Tokens (7d)</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.tokens_7d</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>df85cc37-bfb9-442a-8353-ed9573d46552</uuid>
                            <name>{#PROFILE}: Active sessions</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.active_sessions</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>d8ec02c1-f9d2-4dd1-84c4-cc89fc0af350</uuid>
                                    <expression>{last()}=0 and {avg(1h)}=0</expression>
                                    <name>{#PROFILE}: No active sessions for 1h</name>
                                    <priority>INFO</priority>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <uuid>fd2db90e-8465-45e7-ad9b-90f1b4e28b86</uuid>
                            <name>{#PROFILE}: Total sessions</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_sessions</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>160b6302-ca6b-4c20-9b03-cb70160bad81</uuid>
                            <name>{#PROFILE}: Tool calls</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_tool_calls</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>9d67112b-fc2e-42e9-b70b-9c0a86ec5ffa</uuid>
                                    <expression>{change()}&gt;500</expression>
                                    <name>{#PROFILE}: Tool call spike</name>
                                    <priority>WARNING</priority>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                        <item_prototype>
                            <uuid>3e6eb28b-4aac-44f2-a26e-c31b10962908</uuid>
                            <name>{#PROFILE}: Messages</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_messages</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                    </item_prototypes>
                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>21682573-ce23-4eb6-9dc6-086f952231a5</uuid>
                            <name>{#PROFILE}: Token consumption</name>
                            <width>900</width>
                            <height>200</height>
                            <ymin_type_1>CALCULATED</ymin_type_1>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <color>1A7BFF</color>
                                    <yaxisside>LEFT</yaxisside>
                                    <calc_fnc>LAST</calc_fnc>
                                    <type>SIMPLE</type>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <sortorder>1</sortorder>
                                    <color>00E676</color>
                                    <yaxisside>LEFT</yaxisside>
                                    <calc_fnc>LAST</calc_fnc>
                                    <type>SIMPLE</type>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <sortorder>2</sortorder>
                                    <color>FF9100</color>
                                    <yaxisside>LEFT</yaxisside>
                                    <calc_fnc>LAST</calc_fnc>
                                    <type>SIMPLE</type>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                        <graph_prototype>
                            <uuid>5f2a5356-9596-4ab3-b695-995604b62658</uuid>
                            <name>{#PROFILE}: Session activity</name>
                            <width>900</width>
                            <height>200</height>
                            <ymin_type_1>CALCULATED</ymin_type_1>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <color>1A7BFF</color>
                                    <yaxisside>LEFT</yaxisside>
                                    <calc_fnc>AVG</calc_fnc>
                                    <type>SIMPLE</type>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <sortorder>1</sortorder>
                                    <color>00E676</color>
                                    <yaxisside>LEFT</yaxisside>
                                    <calc_fnc>AVG</calc_fnc>
                                    <type>SIMPLE</type>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                </discovery_rule>
            </discovery_rules>
        </template>
    </templates>
</zabbix_export>

