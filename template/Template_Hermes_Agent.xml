<?xml version="1.0" ?>
<zabbix_export>
    <version>7.0</version>
    <template_groups>
        <template_group>
            <uuid>e1ade0d9-0646-4a30-8b82-bf0951b95bf4</uuid>
            <name>Templates/Applications</name>
        </template_group>
    </template_groups>
    <templates>
        <template>
            <uuid>aa6b317c-e3a9-44a5-8ee2-bdb24d81e2e7</uuid>
            <template>Template Hermes Agent</template>
            <name>Template Hermes Agent</name>
            <description>Zabbix template for monitoring Hermes Agent via its built-in API Server. Monitors gateway health, platform connectivity, token consumption, session activity, and tool usage.</description>
            <groups>
                <group>
                    <name>Templates/Applications</name>
                </group>
            </groups>
            <items/>
            <discovery_rules>
                <discovery_rule>
                    <uuid>0c97aea7-75ed-4ad4-babf-4827c1e66c9f</uuid>
                    <name>Discover Hermes Profiles</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>hermes.profiles.discovery</key>
                    <delay>1h</delay>
                    <filter>
                        <evaltype>AND_OR</evaltype>
                        <conditions>
                            <condition>
                                <macro>{#PROFILE}</macro>
                                <value>.*</value>
                                <operator>MATCHES_REGEX</operator>
                                <formulaid>A</formulaid>
                            </condition>
                        </conditions>
                    </filter>
                    <lifetime_type>DELETE_AFTER</lifetime_type>
                    <lifetime>7d</lifetime>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>36df9117-c7c7-44ff-8d56-5f5454b3fdb0</uuid>
                            <name>{#PROFILE}: Gateway running</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.gateway_up</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>a1a09fd4-ffc5-44a4-bd49-f92300be1284</uuid>
                            <name>{#PROFILE}: Active agents</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.active_agents</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>4d294fc1-cd11-4fc5-a21d-761b6d4a5c16</uuid>
                            <name>{#PROFILE}: Platforms connected</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.platforms_connected</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>aaab55de-7377-4761-9180-61edb085a02c</uuid>
                            <name>{#PROFILE}: Platforms total</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.platforms_total</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>b0067506-f4e2-4860-ab8d-3cb46e66069f</uuid>
                            <name>{#PROFILE}: Gateway PID</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.pid</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>0c6c863e-5f03-4821-baaf-74cb2cb2f8d6</uuid>
                            <name>{#PROFILE}: Input tokens</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_input_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>f3377f9b-afd1-4b7b-a363-3e01017965d6</uuid>
                            <name>{#PROFILE}: Output tokens</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_output_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>5587f02f-eb45-4a8f-b84a-7de6cd3aaeb0</uuid>
                            <name>{#PROFILE}: Cache read tokens</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_cache_read_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>d3de302b-875f-410e-91e1-c28c46e63513</uuid>
                            <name>{#PROFILE}: Tokens (7d)</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.tokens_7d</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>2deff42d-9014-45fa-9f1e-db4af7386e67</uuid>
                            <name>{#PROFILE}: Active sessions</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.active_sessions</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>d825fa6a-c5a2-4694-81b3-542c17e15b8a</uuid>
                            <name>{#PROFILE}: Total sessions</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_sessions</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>3f0deba4-5f64-40e2-8ded-ddd2d5338ceb</uuid>
                            <name>{#PROFILE}: Tool calls</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_tool_calls</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>7b3873f9-4b3b-4d04-a7c3-d6640fed574e</uuid>
                            <name>{#PROFILE}: Messages</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_messages</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                    </item_prototypes>
                    <trigger_prototypes>
                        <trigger_prototype>
                            <uuid>49cb48de-a2ae-4782-9898-b52fa0d9637d</uuid>
                            <expression>{Template Hermes Agent:hermes.check.health[&quot;{#PROFILE}&quot;].last()}=0</expression>
                            <name>{#PROFILE}: Gateway process is down</name>
                            <priority>HIGH</priority>
                            <description>Trigger for {#PROFILE}: Gateway process is down</description>
                        </trigger_prototype>
                        <trigger_prototype>
                            <uuid>01a7435c-c798-410e-ae42-3094cd1b72db</uuid>
                            <expression>{Template Hermes Agent:hermes.check.tokens[&quot;{#PROFILE}&quot;].last()}=0 and {Template Hermes Agent:hermes.check.tokens[&quot;{#PROFILE}&quot;].avg(1h)}=0</expression>
                            <name>{#PROFILE}: No active sessions for 1h</name>
                            <priority>INFO</priority>
                            <description>Trigger for {#PROFILE}: No active sessions for 1h</description>
                        </trigger_prototype>
                        <trigger_prototype>
                            <uuid>f2f35986-083b-42fc-96d2-96f6d386c385</uuid>
                            <expression>{Template Hermes Agent:hermes.check.tokens[&quot;{#PROFILE}&quot;].change()}&gt;500</expression>
                            <name>{#PROFILE}: Tool call spike</name>
                            <priority>WARNING</priority>
                            <description>Trigger for {#PROFILE}: Tool call spike</description>
                        </trigger_prototype>
                    </trigger_prototypes>
                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>70997dba-5a92-4cb4-a062-2222b7192916</uuid>
                            <name>{#PROFILE}: Token consumption</name>
                            <width>900</width>
                            <height>200</height>
                            <ymin_type_1>0</ymin_type_1>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                    <color>1A7BFF</color>
                                    <yaxisside>0</yaxisside>
                                    <calc_fnc>7</calc_fnc>
                                    <type>0</type>
                                </graph_item>
                            </graph_items>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                    <color>00E676</color>
                                    <yaxisside>0</yaxisside>
                                    <calc_fnc>7</calc_fnc>
                                    <type>0</type>
                                </graph_item>
                            </graph_items>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                    <color>FF9100</color>
                                    <yaxisside>0</yaxisside>
                                    <calc_fnc>7</calc_fnc>
                                    <type>0</type>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                        <graph_prototype>
                            <uuid>bc4f2617-f50b-4aae-a51e-e8700ee6924f</uuid>
                            <name>{#PROFILE}: Session activity</name>
                            <width>900</width>
                            <height>200</height>
                            <ymin_type_1>0</ymin_type_1>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                    <color>1A7BFF</color>
                                    <yaxisside>0</yaxisside>
                                    <calc_fnc>2</calc_fnc>
                                    <type>0</type>
                                </graph_item>
                            </graph_items>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                    <color>00E676</color>
                                    <yaxisside>0</yaxisside>
                                    <calc_fnc>2</calc_fnc>
                                    <type>0</type>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                </discovery_rule>
            </discovery_rules>
        </template>
    </templates>
</zabbix_export>

