<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>7.0</version>
    <date>2026-06-06T00:00:00Z</date>
    <template_groups>
        <template_group>
            <uuid>ac7c55a5-ece3-441a-b769-9a92f6178532</uuid>
            <name>Templates/Applications</name>
        </template_group>
    </template_groups>
    <templates>
        <template>
            <uuid>c055d073-c3ef-4fc0-a832-77d62fa12802</uuid>
            <template>Template Hermes Agent</template>
            <name>Template Hermes Agent</name>
            <description>Zabbix template for monitoring Hermes Agent via its built-in API Server. Monitors gateway health, platform connectivity, token consumption, session activity, and tool usage across Hermes profiles with API_SERVER_ENABLED=true. Requires hermes_check.py and hermes_lld.py on the Zabbix agent.</description>
            <groups>
                <group>
                    <name>Templates/Applications</name>
                </group>
            </groups>
            <items/>
            <discovery_rules>
                <discovery_rule>
                    <uuid>b53bf222-f745-47c5-834a-397d52a98563</uuid>
                    <name>Discover Hermes Profiles</name>
                    <type>ZABBIX_AGENT</type>
                    <key>hermes.profiles.discovery</key>
                    <delay>1h</delay>
                    <keep_lost_resources>1d</keep_lost_resources>
                    <filter>
                        <conditions>
                            <condition>
                                <macro>{#PROFILE}</macro>
                                <value>.*</value>
                                <formulaid>A</formulaid>
                                <operator>REGEXP</operator>
                            </condition>
                        </conditions>
                    </filter>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>c2eb3ccb-79d2-42b3-afd3-4709a366b2d5</uuid>
                            <name>{#PROFILE}: Gateway running</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.health["{#PROFILE}"]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <description>1 if gateway_state is running, 0 otherwise</description>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.gateway_up</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <triggers>
                                <trigger_prototype>
                                    <uuid>586bc174-23a5-49d3-97d0-85ea42eb6d18</uuid>
                                    <expression>{last()}=0</expression>
                                    <name>{#PROFILE}: Gateway process is down</name>
                                    <priority>HIGH</priority>
                                    <description>The Hermes gateway for profile {#PROFILE} is not running. Check the systemd service or gateway logs.</description>
                                </trigger_prototype>
                            </triggers>
                        </item_prototype>
                        <item_prototype>
                            <uuid>00f15044-2fbb-4c2d-9831-6bba97d4c217</uuid>
                            <name>{#PROFILE}: Active agents</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.health["{#PROFILE}"]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <description>Number of active agent runs</description>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.active_agents</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>bba0f946-9fdf-46ad-9043-a5f8cbaef7c1</uuid>
                            <name>{#PROFILE}: Platforms connected</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.health["{#PROFILE}"]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <description>Number of connected messaging platforms</description>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.platforms_connected</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>5de430f3-585e-4669-a1fc-0283968f7f60</uuid>
                            <name>{#PROFILE}: Platforms total</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.health["{#PROFILE}"]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <description>Total configured platforms</description>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.platforms_total</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>9be2e631-2e42-44a3-ac3a-8b1e70c24e33</uuid>
                            <name>{#PROFILE}: Gateway PID</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.health["{#PROFILE}"]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.pid</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>ff6b39f9-88a4-4dee-aaa8-52ee7e1c8629</uuid>
                            <name>{#PROFILE}: Input tokens</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.tokens["{#PROFILE}"]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_input_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>7bb937f7-4f51-4b08-b6aa-b95e37a56a99</uuid>
                            <name>{#PROFILE}: Output tokens</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.tokens["{#PROFILE}"]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_output_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>3b0a9266-91e6-44b5-9d98-a9337ae73f88</uuid>
                            <name>{#PROFILE}: Cache read tokens</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.tokens["{#PROFILE}"]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_cache_read_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>61d879b5-446b-4a94-aaf8-c439a080a8f5</uuid>
                            <name>{#PROFILE}: Tokens (7d)</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.tokens["{#PROFILE}"]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.tokens_7d</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>51a8549a-65f4-4a97-a061-4b459e3fdb14</uuid>
                            <name>{#PROFILE}: Active sessions</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.tokens["{#PROFILE}"]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.active_sessions</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <triggers>
                                <trigger_prototype>
                                    <uuid>1af25e64-5d85-4186-8c7e-eb4d7864dd15</uuid>
                                    <expression>{last()}=0 and {avg(1h)}=0</expression>
                                    <name>{#PROFILE}: No active sessions for 1h</name>
                                    <priority>INFO</priority>
                                    <description>No active sessions for profile {#PROFILE} in the last hour</description>
                                </trigger_prototype>
                            </triggers>
                        </item_prototype>
                        <item_prototype>
                            <uuid>ce8a34bf-a94c-42e8-9839-967c182e0e4b</uuid>
                            <name>{#PROFILE}: Total sessions</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.tokens["{#PROFILE}"]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_sessions</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>0c6af8e1-bee7-4f77-9ef7-3d4cd3f07018</uuid>
                            <name>{#PROFILE}: Tool calls</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.tokens["{#PROFILE}"]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_tool_calls</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <triggers>
                                <trigger_prototype>
                                    <uuid>1cf4a42c-61e5-46f8-af6b-584ef03d326f</uuid>
                                    <expression>{change()}&gt;500</expression>
                                    <name>{#PROFILE}: Tool call spike</name>
                                    <priority>WARNING</priority>
                                    <description>Tool call count jumped by more than 500 since last check</description>
                                </trigger_prototype>
                            </triggers>
                        </item_prototype>
                        <item_prototype>
                            <uuid>c2d2ddf3-2de1-4602-80d5-9ff9e2faf938</uuid>
                            <name>{#PROFILE}: Messages</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.tokens["{#PROFILE}"]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_messages</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                    </item_prototypes>
                    <trigger_prototypes/>
                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>7316281e-c1e0-40a1-b9e3-b2a2a5fd21fe</uuid>
                            <name>{#PROFILE}: Token consumption</name>
                            <width>900</width>
                            <height>200</height>
                            <ymin_type_1>0</ymin_type_1>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens["{#PROFILE}"]</key>
                                    </item>
                                    <color>1A7BFF</color>
                                    <yaxisside>0</yaxisside>
                                    <calc_fnc>7</calc_fnc>
                                    <type>0</type>
                                </graph_item>
                                <graph_item>
                                    <sortorder>1</sortorder>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens["{#PROFILE}"]</key>
                                    </item>
                                    <color>00E676</color>
                                    <yaxisside>0</yaxisside>
                                    <calc_fnc>7</calc_fnc>
                                    <type>0</type>
                                </graph_item>
                                <graph_item>
                                    <sortorder>2</sortorder>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens["{#PROFILE}"]</key>
                                    </item>
                                    <color>FF9100</color>
                                    <yaxisside>0</yaxisside>
                                    <calc_fnc>7</calc_fnc>
                                    <type>0</type>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                        <graph_prototype>
                            <uuid>c421f73f-91f8-4d3f-9dbc-616432623757</uuid>
                            <name>{#PROFILE}: Session activity</name>
                            <width>900</width>
                            <height>200</height>
                            <ymin_type_1>0</ymin_type_1>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens["{#PROFILE}"]</key>
                                    </item>
                                    <color>1A7BFF</color>
                                    <yaxisside>0</yaxisside>
                                    <calc_fnc>2</calc_fnc>
                                    <type>0</type>
                                </graph_item>
                                <graph_item>
                                    <sortorder>1</sortorder>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens["{#PROFILE}"]</key>
                                    </item>
                                    <color>00E676</color>
                                    <yaxisside>0</yaxisside>
                                    <calc_fnc>2</calc_fnc>
                                    <type>0</type>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                </discovery_rule>
            </discovery_rules>
        </template>
    </templates>
</zabbix_export>