<?xml version="1.0" ?>
<zabbix_export>
    <version>7.0</version>
    <date>2026-06-06T00:00:00Z</date>
    <template_groups>
        <template_group>
            <uuid>14923766-569a-435d-9fe3-07c65ed1cb01</uuid>
            <name>Templates/Applications</name>
        </template_group>
    </template_groups>
    <templates>
        <template>
            <uuid>8b8672cb-c7fc-45b0-96a0-5fd6dd8c7c13</uuid>
            <template>Template Hermes Agent</template>
            <name>Template Hermes Agent</name>
            <description>Zabbix template for monitoring Hermes Agent. Uses the built-in API Server to collect gateway health, token consumption, and session metrics.</description>
            <groups>
                <group>Templates/Applications</group>
            </groups>
            <items/>
            <discovery_rules>
                <discovery_rule>
                    <uuid>e3de0c5a-3a9a-4fcc-ad4f-32eaca8606f9</uuid>
                    <name>Discover Hermes Profiles</name>
                    <type>ZABBIX_AGENT</type>
                    <key>hermes.profiles.discovery</key>
                    <delay>1h</delay>
                    <keep_lost_resources>1d</keep_lost_resources>
                    <filter>
                        <conditions>
                            <condition>
                                <macro>{#PROFILE}</macro>
                                <value>.*</value>
                                <formulaid>A</formulaid>
                                <operator>REGEXP</operator>
                            </condition>
                        </conditions>
                    </filter>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>f2ddb92b-f141-47f2-814a-a949ad260d39</uuid>
                            <name>{#PROFILE}: Gateway running</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.gateway_up</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <triggers>
                                <trigger_prototype>
                                    <uuid>c705ee2f-f5e5-4607-b510-4db7fa1d2125</uuid>
                                    <expression>{last()}=0</expression>
                                    <name>{#PROFILE}: Gateway process is down</name>
                                    <priority>HIGH</priority>
                                </trigger_prototype>
                            </triggers>
                        </item_prototype>
                    </item_prototypes>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>ecbb97a5-dcac-4bd3-943c-0f6f2b71f96b</uuid>
                            <name>{#PROFILE}: Active agents</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.active_agents</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                    </item_prototypes>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>ef900bdb-21a0-40df-aa81-629a13bf2500</uuid>
                            <name>{#PROFILE}: Platforms connected</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.platforms_connected</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
