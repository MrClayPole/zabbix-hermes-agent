<?xml version="1.0" ?>
<zabbix_export>
    <version>7.0</version>
    <template_groups>
        <template_group>
            <uuid>c9f092bb-0c40-474f-81e0-d73a879f7dea</uuid>
            <name>Templates/Applications</name>
        </template_group>
    </template_groups>
    <templates>
        <template>
            <uuid>9dd89151-2c46-4909-8cfb-5ab52c7ea732</uuid>
            <template>Template Hermes Agent</template>
            <name>Template Hermes Agent</name>
            <description>Zabbix template for monitoring Hermes Agent via its built-in API Server. Monitors gateway health, platform connectivity, token consumption, session activity, and tool usage across Hermes profiles with API_SERVER_ENABLED=true.</description>
            <groups>
                <group>
                    <name>Templates/Applications</name>
                </group>
            </groups>
            <items/>
            <discovery_rules>
                <discovery_rule>
                    <uuid>cb553f07-1462-43e9-8387-244416abc26f</uuid>
                    <name>Discover Hermes Profiles</name>
                    <type>ZABBIX_AGENT</type>
                    <key>hermes.profiles.discovery</key>
                    <delay>1h</delay>
                    <keep_lost_resources>1d</keep_lost_resources>
                    <filter>
                        <conditions>
                            <condition>
                                <macro>{#PROFILE}</macro>
                                <value>.*</value>
                                <formulaid>A</formulaid>
                                <operator>REGEXP</operator>
                            </condition>
                        </conditions>
                    </filter>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>2df84682-0e69-4d45-8976-60d9de30c924</uuid>
                            <name>{#PROFILE}: Gateway running</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.gateway_up</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <triggers>
                                <trigger_prototype>
                                    <uuid>8de9142f-85b6-4ea2-9a5b-bc741dc01e9b</uuid>
                                    <expression>{last()}=0</expression>
                                    <name>{#PROFILE}: Gateway process is down</name>
                                    <priority>HIGH</priority>
                                </trigger_prototype>
                            </triggers>
                        </item_prototype>
                        <item_prototype>
                            <uuid>79aaacce-091a-4fcf-af6b-e968429df3df</uuid>
                            <name>{#PROFILE}: Active agents</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.active_agents</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>f714df6c-2935-4143-8327-0abc75186964</uuid>
                            <name>{#PROFILE}: Platforms connected</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.platforms_connected</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>d5ac4f3b-9c69-4d81-95ae-17567d2f8ce9</uuid>
                            <name>{#PROFILE}: Platforms total</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.platforms_total</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>2bdd66a6-74e6-441d-8047-96e52e6a429f</uuid>
                            <name>{#PROFILE}: Gateway PID</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.health[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.pid</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>fe90faa8-f9a3-41e9-977d-b1c08b58cb2c</uuid>
                            <name>{#PROFILE}: Input tokens</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_input_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>3f8baa38-5c21-432a-812f-f79ec39e4133</uuid>
                            <name>{#PROFILE}: Output tokens</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_output_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>de512a28-376b-4f7b-baf4-d08aab13c246</uuid>
                            <name>{#PROFILE}: Cache read tokens</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_cache_read_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>ac6da169-d2e2-46db-bd24-b1b881c50dc1</uuid>
                            <name>{#PROFILE}: Tokens (7d)</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.tokens_7d</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>91d38ede-136a-43c0-b0c8-5e881facbf89</uuid>
                            <name>{#PROFILE}: Active sessions</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.active_sessions</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <triggers>
                                <trigger_prototype>
                                    <uuid>b1e66a67-70cb-4f4f-91d0-da26ce9ce4fc</uuid>
                                    <expression>{last()}=0 and {avg(1h)}=0</expression>
                                    <name>{#PROFILE}: No active sessions for 1h</name>
                                    <priority>INFO</priority>
                                </trigger_prototype>
                            </triggers>
                        </item_prototype>
                        <item_prototype>
                            <uuid>c2f2c164-4bf3-4077-b338-763edfd8d7bd</uuid>
                            <name>{#PROFILE}: Total sessions</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_sessions</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>92bf8479-7aa4-4a19-8ce0-d5593253c967</uuid>
                            <name>{#PROFILE}: Tool calls</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_tool_calls</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                            <triggers>
                                <trigger_prototype>
                                    <uuid>9b348f13-ae10-4b50-bbd6-7fbfa034e331</uuid>
                                    <expression>{change()}&gt;500</expression>
                                    <name>{#PROFILE}: Tool call spike</name>
                                    <priority>WARNING</priority>
                                </trigger_prototype>
                            </triggers>
                        </item_prototype>
                        <item_prototype>
                            <uuid>2958ab31-22dc-4a8f-9eb8-3786cf750526</uuid>
                            <name>{#PROFILE}: Messages</name>
                            <type>ZABBIX_AGENT</type>
                            <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_messages</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                    </item_prototypes>
                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>3db23b21-7e98-4c69-ae6d-2fa298297fb1</uuid>
                            <name>{#PROFILE}: Token consumption</name>
                            <width>900</width>
                            <height>200</height>
                            <ymin_type_1>0</ymin_type_1>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                    <color>1A7BFF</color>
                                    <yaxisside>0</yaxisside>
                                    <calc_fnc>7</calc_fnc>
                                    <type>0</type>
                                </graph_item>
                            </graph_items>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                    <color>00E676</color>
                                    <yaxisside>0</yaxisside>
                                    <calc_fnc>7</calc_fnc>
                                    <type>0</type>
                                </graph_item>
                            </graph_items>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                    <color>FF9100</color>
                                    <yaxisside>0</yaxisside>
                                    <calc_fnc>7</calc_fnc>
                                    <type>0</type>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                        <graph_prototype>
                            <uuid>42657698-b466-4530-a48d-2ff9d7c17c63</uuid>
                            <name>{#PROFILE}: Session activity</name>
                            <width>900</width>
                            <height>200</height>
                            <ymin_type_1>0</ymin_type_1>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                    <color>1A7BFF</color>
                                    <yaxisside>0</yaxisside>
                                    <calc_fnc>2</calc_fnc>
                                    <type>0</type>
                                </graph_item>
                            </graph_items>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check.tokens[&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                    <color>00E676</color>
                                    <yaxisside>0</yaxisside>
                                    <calc_fnc>2</calc_fnc>
                                    <type>0</type>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                </discovery_rule>
            </discovery_rules>
        </template>
    </templates>
</zabbix_export>

