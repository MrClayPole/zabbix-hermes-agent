<?xml version="1.0" ?>
<zabbix_export>
    <version>7.0</version>
    <template_groups>
        <template_group>
            <uuid>1588c62dbabe42228b817e5cbf21d849</uuid>
            <name>Templates/Applications</name>
        </template_group>
    </template_groups>
    <templates>
        <template>
            <uuid>1da313f20a514b3ca43139a102dee436</uuid>
            <template>Template Hermes Agent</template>
            <name>Template Hermes Agent</name>
            <description>Zabbix template for monitoring Hermes Agent via its built-in API Server. Monitors gateway health, platform connectivity, token consumption, session activity, and tool usage.</description>
            <groups>
                <group>
                    <name>Templates/Applications</name>
                </group>
            </groups>
            <items/>
            <discovery_rules>
                <discovery_rule>
                    <uuid>8b93f62656134b40a455e5f9164815cd</uuid>
                    <name>Discover Hermes Profiles</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>hermes.profiles.discovery</key>
                    <delay>1h</delay>
                    <filter>
                        <evaltype>AND_OR</evaltype>
                        <conditions>
                            <condition>
                                <macro>{#PROFILE}</macro>
                                <value>.*</value>
                                <operator>MATCHES_REGEX</operator>
                                <formulaid>A</formulaid>
                            </condition>
                        </conditions>
                    </filter>
                    <lifetime_type>DELETE_AFTER</lifetime_type>
                    <lifetime>7d</lifetime>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>592e4ded09c44f3598b921a57c7c143d</uuid>
                            <name>{#PROFILE}: Gateway running</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;health&quot;,&quot;gateway_up&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.gateway_up</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>676e5b2976cf4b46abc6fb7034a5540e</uuid>
                            <name>{#PROFILE}: Active agents</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;health&quot;,&quot;active_agents&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.active_agents</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>8f1c045236974284b61c805355f0503b</uuid>
                            <name>{#PROFILE}: Platforms connected</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;health&quot;,&quot;platforms_connected&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.platforms_connected</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>80448e064efd4937aa8c67c7ee9df3b0</uuid>
                            <name>{#PROFILE}: Platforms total</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;health&quot;,&quot;platforms_total&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>1m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.platforms_total</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>226c7d9c65f14c54a9e47702ac511ce8</uuid>
                            <name>{#PROFILE}: Gateway PID</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;health&quot;,&quot;pid&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.pid</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>05584240123d4e56950157b4596cdfdc</uuid>
                            <name>{#PROFILE}: Input tokens</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;input_tokens&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_input_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>f84ea03fbed742629adb0fb5648a399f</uuid>
                            <name>{#PROFILE}: Output tokens</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;output_tokens&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_output_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>3c93a97b90584807bd97a6ca9870fbab</uuid>
                            <name>{#PROFILE}: Cache read tokens</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;cache_read_tokens&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_cache_read_tokens</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>c79faab89563489d8ac4f1c02e860716</uuid>
                            <name>{#PROFILE}: Tokens (7d)</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;tokens_7d&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <units>tokens</units>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.tokens_7d</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>1d153f0698ec4cfeb07cc96cfe00353b</uuid>
                            <name>{#PROFILE}: Active sessions</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;active_sessions&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.active_sessions</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>764d860c8e16456e952e6b1970a0b54c</uuid>
                            <name>{#PROFILE}: Total sessions</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;total_sessions&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_sessions</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>3d88e533990345f7b23dfc1dd34dd6ca</uuid>
                            <name>{#PROFILE}: Tool calls</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;tool_calls&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_tool_calls</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                        <item_prototype>
                            <uuid>2c04e378dd7c43219c1568c76ba48e46</uuid>
                            <name>{#PROFILE}: Messages</name>
                            <type>ZABBIX_PASSIVE</type>
                            <key>hermes.check[&quot;tokens&quot;,&quot;total_messages&quot;,&quot;{#PROFILE}&quot;]</key>
                            <delay>5m</delay>
                            <value_type>UNSIGNED</value_type>
                            <preprocessing>
                                <step>
                                    <type>JSONPATH</type>
                                    <parameters>
                                        <parameter>$.total_messages</parameter>
                                    </parameters>
                                </step>
                            </preprocessing>
                        </item_prototype>
                    </item_prototypes>
                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>c99f02e44ae54a57a07ce0e0e77b293e</uuid>
                            <name>{#PROFILE}: Token consumption</name>
                            <width>900</width>
                            <height>200</height>
                            <ymin_type_1>CALCULATED</ymin_type_1>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <color>1A7BFF</color>
                                    <yaxisside>LEFT</yaxisside>
                                    <calc_fnc>LAST</calc_fnc>
                                    <type>SIMPLE</type>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check[&quot;tokens&quot;,&quot;input_tokens&quot;,&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <sortorder>1</sortorder>
                                    <color>00E676</color>
                                    <yaxisside>LEFT</yaxisside>
                                    <calc_fnc>LAST</calc_fnc>
                                    <type>SIMPLE</type>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check[&quot;tokens&quot;,&quot;output_tokens&quot;,&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <sortorder>2</sortorder>
                                    <color>FF9100</color>
                                    <yaxisside>LEFT</yaxisside>
                                    <calc_fnc>LAST</calc_fnc>
                                    <type>SIMPLE</type>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check[&quot;tokens&quot;,&quot;cache_read_tokens&quot;,&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                        <graph_prototype>
                            <uuid>15e52a76f912424b8148ce9b28e29547</uuid>
                            <name>{#PROFILE}: Session activity</name>
                            <width>900</width>
                            <height>200</height>
                            <ymin_type_1>CALCULATED</ymin_type_1>
                            <graph_items>
                                <graph_item>
                                    <sortorder>0</sortorder>
                                    <color>1A7BFF</color>
                                    <yaxisside>LEFT</yaxisside>
                                    <calc_fnc>AVG</calc_fnc>
                                    <type>SIMPLE</type>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check[&quot;tokens&quot;,&quot;active_sessions&quot;,&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                </graph_item>
                                <graph_item>
                                    <sortorder>1</sortorder>
                                    <color>00E676</color>
                                    <yaxisside>LEFT</yaxisside>
                                    <calc_fnc>AVG</calc_fnc>
                                    <type>SIMPLE</type>
                                    <item>
                                        <host>Template Hermes Agent</host>
                                        <key>hermes.check[&quot;tokens&quot;,&quot;total_sessions&quot;,&quot;{#PROFILE}&quot;]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                </discovery_rule>
            </discovery_rules>
        </template>
    </templates>
</zabbix_export>

